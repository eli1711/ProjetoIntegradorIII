FLASK_ENV=development
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/escola_db
DB_NAME=escola_db
DB_USER=postgres
DB_PASSWORD=change-me
JWT_SECRET_KEY=change-me-before-production
SECRET_KEY=change-me-before-production
FRONTEND_URL=http://localhost:8080
MAX_UPLOAD_MB=10
CREATE_DEFAULT_ADMIN=0
DEFAULT_ADMIN_NAME=Administrador
DEFAULT_ADMIN_EMAIL=admin@admin.com
DEFAULT_ADMIN_PASSWORD=
ALLOW_PASSWORD_RESET_TOKEN_LOG=0
ENABLE_DEBUG_ROUTES=0
ENABLE_OPENAI_ANALYSIS=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20
